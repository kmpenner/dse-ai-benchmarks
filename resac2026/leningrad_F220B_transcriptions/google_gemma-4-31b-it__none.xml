          <lb n="34"/>
          <lb n="35"/>
          <lb n="36"/>
          <lb n="37"/>
          <lb n="38"/>
          <lb n="39"/>
          <lb n="40"/>
        </cb>
        <cb n="2">
          <lb n="1">רֹאשׁ אֱמוּנָתָם לְמַעַן פְּנֵי</lb>
          <lb n="2">וְחַבְרָהּ וּבְחַבְרָהּ לְמַעַן לֹא</lb>
          <lb n="3">וְדַא־אֱמֶת וְלֹא רָבְדָה</lb>
          <lb n="4">בְּשֵׁם אֲבִיר עֶבֶד שְׁבָחָה</lb>
          <lb n="5">עִמָּנוּם שְׁפָנָתָם אֶת־רַמְּתָה</lb>
          <lb n="6">לְבַגְרֵי וְחַיּוֹת אֶל־נִשְׁמָתָה</lb>
          <lb n="7">וּשְׁמַעְתָּה מִפִּיוּתָם וְסַבְּרָתָם</lb>
          <lb n="8">וְתַעֲמַדְתָּה חַבְרָהּ בְּסַבְּרָתָם</lb>
          <lb n="9"/>
          <lb n="10">מִלּוּלֵי בְּמַדְבָּה שְׁבַע־בְּעֵר</lb>
          <lb n="11">נִגְעָה וְחִלּוּבָהּ וְעָבַת</lb>
          <lb n="12">חִוְּרוֹת שְׁבַע מִכּוֹן בְּנָט</lb>
          <lb n="13">פִּקְדוּת שְׁבַע לְהַבְרָה רָמְתָה</lb>
          <lb n="14"/>
          <lb n="15"/>
          <lb n="16"/>
          <lb n="17">כְּעֶנֶג שׁוֹנָתָם וְעִנְּתָה</lb>
          <lb n="18">אֱלֹהִים שְׁבַע נְגִיעָה לְמַחְלָה</lb>
          <lb n="19">דִּבְדוּבָנִים אֶמְרָתוֹתָה</lb>
          <lb n="20">שְׁבַע נְטִיעוֹת אֶת־יִשְׁמָה</lb>
          <lb n="21">מִרְאִיתָם וְסוֹבְבָם אֶמְרָתוֹתָה</lb>
          <lb n="22">וְעוֹמַדְתָּה אֶפְרָתָה בְּנִי</lb>
          <lb n="23">תִּבְנֶה לְמַעַן הַפְּגִיעָה בְּסַבְּרָתָם</lb>
          <lb n="24">תִּבְנֶה לְמַעַן הַפְּגִיעָה בְּסַבְּרָתָם</lb>
          <lb n="25">תּוֹעִיתָם וּבְמַעֲשָׂהּ שְׁבָע</lb>
          <lb n="26">תּוֹעִיתָם וּבְמַעֲשָׂהּ שְׁבָע</lb>
          <lb n="27">כְּתֹבֶת עִמָּהּ וְחִלּוּבָהּ אֶל־חִישׁ</lb>
          <lb n="28">וְשַׁבְּלָה כְּדַאי מִכּוֹל אֶל־אֶבֶת</lb>
          <lb n="29">אוֹזְנָהּ עִמָּהּ חִלְשָׁתָה</lb>
          <lb n="30">וּמַעֲמַדְתָּם שְׁנָה נַפְשׁוֹתָיו</lb>
          <lb n="31">עַל כְּבַרְתָּם אֶת־נָטָה וְעָב</lb>
        </cb>
        <cb n="3">
          <lb n="1">וְנִפְרְשׂוּ בְּנָבָה אֶת־עֶבֶד</lb>
          <lb n="2">עִנְיָנָם כְּסוֹ לְמִתְהַלְּלָה</lb>
          <lb n="3">אוֹנָה שְׁבַע מִדְּבָרִים־דּוֹדִים</lb>
          <lb n="4">כְּלָל וְחַיּוּתָם הַמּוֹרִידָה</lb>
          <lb n="5">נַעֲלִימָנָם שְׁבַע חַיּוֹתָה</lb>
          <lb n="6">חִלּוּבָהּ וְחַיּוֹת הַדְּבַר שָׁם</lb>
          <lb n="7">בְּשַׁבְּתָם אֲדִירָיוּם וְשִׁפְתּוֹ</lb>
          <lb n="8">נִתְרַבּוּן בְּעָלָה</lb>
          <lb n="9"/>
          <lb n="10">לְבַרְנָה וּנְגִיעָה</lb>
          <lb n="11">לְאִבּוּר חִיוּתָם אֶת־מִלּוּתָה</lb>
          <lb n="12">בְּשׁוּטָה לְבַדְבָּנָה אֶת־אִם</lb>
          <lb n="13">נְאִימוּתָם לְבַדְבָּנָה אֶת־אִם</lb>
          <lb n="14">אֲמַת־בּוֹרָה וּמַעֲשָׂהּ טוֹב</lb>
          <lb n="15">הָאִירָה וְחַיּוֹתָהּ וְסַבְּרָתָה</lb>
          <lb n="16">וְחִלּוּבָהּ תַּחְתָּבָה בְּנִי־בּוֹ</lb>
          <lb n="17">יוֹחָנָן דְּבַר</lb>
          <lb n="18"/>
          <lb n="19">אֲבָה הָגִיעָה לִנְגּוּד</lb>
          <lb n="20">קָדָה וְנַעֲמָה לְמַעַן שִׁפְתּוֹ</lb>
          <lb n="21">צִדְקָה וְחִלּוּבָהּ וְעָבַת</lb>
          <lb n="22">כְּסַבְּרָתָהם לְמַעַן כְּבָרָה</lb>
          <lb n="23">שְׁבַע מִדְּבָרִים שְׁבַע מִדּוֹת</lb>
          <lb n="24">וְחִבְּרוּנָם כְּלָל אֶת־בְּחֵר שְׁבַע</lb>
          <lb n="25">וְעָמְדָה שְׁבַע כְּמַעֲשָׂהּ וְחַיּוֹתָה</lb>
          <lb n="26">עִבּוּ אֶת־חִלּוּבָנָה אֶת־</lb>
          <lb n="27">קוֹשׁוֹ וְשָׂרָה לְנִגּוּד חַיּוֹת</lb>
          <lb n="28">עַל מִבְּתָהּ שְׁבַע וְרִשּׁוּתָה</lb>
          <lb n="29">כָּפָה כְּלָה בְּסַבְּרָתָהּ חִלּוּב</lb>
          <lb n="30">לְבָבָה מִכְּבַרְתָּהּ וְעָב</lb>
          <lb n="31">לְבנָא הָאֲרִידָה וְחַיּוֹתָהּ</lb>
          <lb n="32">לְבנָא הָאֲרִידָה וְחַיּוֹתָהּ</lb>
          <lb n="33">אֲבִירוּתָהּ אֶל־נִשְׁמָתָה</lb>
        </cb>
      </div>
