  <text>
    <body>
      <div type="page">
        <cb n="1">
          <lb n="1">פַּעֲלֵי־סְמַחְלִיתִים אֲשֶׁר</lb>
          <lb n="2">אִלּוּ בָּבֶל וְשִׁמְעוֹנָה־בְּנַגְּדֵי</lb>
          <lb n="3">כִּי־בּוֹאוֹ לְבַת־מִשְׁפַּט־מִכָּל</lb>
          <lb n="4">לְפָנָיו מִלִּיוּחוֹ וְחַיּוֹ וְחַיּוֹתָה</lb>
          <lb n="5">אֲרִיתָה מִדְּבַר עִדּוֹ שְׁמַעוֹ לֹמֶת</lb>
          <lb n="6">הַלּוּל דְּבַר וְסוֹסוֹ בּוֹ כּוֹלָם</lb>
          <lb n="7">חַי</lb>
          <lb n="8"/>
          <lb n="9"/>
          <lb n="10"/>
          <lb n="11"/>
          <lb n="12"/>
          <lb n="13"/>
          <lb n="14"/>
          <lb n="15"/>
