   <text>
      <body>
         <div type="page" n="220.5">
            <cb n="1"/>
            <lb n="1"/>וּבְפֹר שְׁכֶם כְּפִיכֶם אֱלֹהִים
            <lb n="2"/>עִמָּכֶם גַּם כִּי תִרְבּוּ תְפִלָּה
            <lb n="3"/>אֵינֶנִּי שֹׁמֵעַ יְדֵיכֶם דָּמִים׃
            <lb n="4"/>מָלְאוּ רַחֲצוּ הִזַּכּוּ הָסִירוּ רֹעַ
            <lb n="5"/>מַעַלְלֵיכֶם מִנֶּגֶד עֵינַי חִדְלוּ
            <lb n="6"/>הָרֵעַ לִמְדוּ הֵיטֵב דִּרְשׁוּ׃
            <lb n="7"/>מִשְׁפָּט אַשְּׁרוּ חָמוֹץ שִׁפְטוּ
            <lb n="8"/>יָתוֹם רִיבוּ אַלְמָנָה׃
            <lb n="9"/>לְכוּ נָא וְנִוָּכְחָה׃
            <lb n="10"/>וְאָמַר יְהוָה אִם יִהְיוּ חֲטָאֵיכֶם
            <lb n="11"/>כַּשָּׁנִים כַּשֶּׁלֶג יַלְבִּינוּ אִם
            <lb n="12"/>יַאֲדִימוּ כַתּוֹלָע כַּצֶּמֶר יִהְיוּ
            <lb n="13"/>אִם תֹּאבוּ וּשְׁמַעְתֶּם טוֹב׃
            <lb n="14"/>הָאָרֶץ תֹּאכֵלוּ וְאִם תְּמָאֵנוּ
            <lb n="15"/>וּמְרִיתֶם חֶרֶב תְּאֻכְּלוּ כִּי פִי
            <lb n="16"/>יְהוָה דִּבֵּר׃
            <lb n="17"/>אֵיכָה הָיְתָה לְזוֹנָה׃
            <lb n="18"/>קִרְיָה נֶאֱמָנָה מְלֵאֲתִי מִשְׁפָּט
            <lb n="19"/>צֶדֶק יָלִין בָּהּ וְעַתָּה מְרַצְּחִים׃
            <lb n="20"/>כַּסְפֵּךְ הָיָה לְסִיגִים סָבְאֵךְ מָהוּל
            <lb n="21"/>בַּמָּיִם שָׂרַיִךְ סוֹרְרִים
            <lb n="22"/>וְחַבְרֵי גַּנָּבִים כֻּלּוֹ אֹהֵב שֹׁחַד
            <lb n="23"/>וְרֹדֵף שַׁלְמֹנִים יָתוֹם לֹא
            <lb n="24"/>יִשְׁפֹּטוּ וְרִיב אַלְמָנָה לֹא י
            <lb n="25"/>יָבוֹא אֲלֵיהֶם׃
            <lb n="26"/>לָכֵן נְאֻם הָאָדוֹן יְהוָה צְבָאוֹת
            <lb n="27"/>אֲבִיר יִשְׂרָאֵל הוֹי אֲנַחֵם׃
            <cb n="2"/>
            <lb n="1"/>מֵעַל כִּסֵּא הַמְּלָכִים אֲשֶׁר
            <lb n="2"/>אִתּוֹ בְּכָל וְשָׂנֵא אֶת בִּגְדֵי
            <lb n="3"/>בְּלֹא וְאֹכַל לְחֶסֶתָּמִיד׃
            <lb n="4"/>לְפָנָיו כָּל יְמֵי חַיָּיו וְאַרְחָתוֹ
            <lb n="5"/>אָרְחַת תָּמִיד נָתְנוּ לוֹ מֵאֵת
            <lb n="6"/>הַמֶּלֶךְ דְּבַר יוֹם בְּיוֹמוֹ כָּל יְמֵי
            <lb n="7"/>חַיָּיו
            <lb n="8"/>רֹאשׁ אִיזְבוּ מַתְּסְפִינֶע
            <lb n="9"/>וְחַבּוּרָה וּמַכָּה טְרִיָּה לֹא אֻזְּרָן
            <lb n="10"/>וְלֹא חֻבְּשׁוּ וְלֹא רֻכְּבָה׃
            <lb n="11"/>בַּשָּׁמַיִם אֶרְצְכֶם שְׁמָמָה׃
            <lb n="12"/>עָרֵיכֶם שְׂרֻפוֹת אֵשׁ אַדְמַתְכֶם
            <lb n="13"/>לְנֶגְדְּכֶם זָרִים אֹכְלִים אֹתָהּ
            <lb n="14"/>וּשְׁמָמָה כְּמַהְפֵּכַת זָרִים׃
            <lb n="15"/>וְנוֹתְרָה בַת צִיּוֹן כְּסֻכָּה בְכֶרֶם
            <lb n="16"/>כִּמְלוּנָה בְמִקְשָׁה בְּעִיר׃
            <lb n="17"/>נְצוּרָה לְלִישׁוֹן וּמִתּוֹךְ צְבָאוֹת׃
            <lb n="18"/>הַוּתִיר לָנוּ שְׁרִיד כִּמְעַט כְּ
            <lb n="19"/>סְדוֹם הָיִינוּ לַעֲמֹרָה דָּמִינוּ׃
            <lb n="20"/>קְצִינֵי סְדֹם הַאֲזִינוּ תּוֹרַת׃
            <lb n="21"/>אֱלֹהֵינוּ עַם עֲמֹרָה לְמַחֲלִי
            <lb n="22"/>רַב זִבְחֵיכֶם יֹאמַר יְהוָה׃
            <lb n="23"/>שָׂבַעְתִּי עֹלוֹת אֵילִים וְחֵלֶב
            <lb n="24"/>מְרִיאִים וְדַם פָּרִים וּכְבָשִׂים
            <lb n="25"/>וְעַתּוּדִים לֹא חָפַצְתִּי כִּי׃
            <lb n="26"/>תָבֹאוּ לִרְאוֹת פָּנַי מִי בִקֵּשׁ
            <lb n="27"/>זֹאת מִיֶּדְכֶם רְמֹס חֲצֵרָי לֹא
            <lb n="28"/>תוֹסִיפוּ הָבִיא מִנְחַת שָׁוְא
            <lb n="29"/>קְטֹרֶת תּוֹעֵבָה הִיא חֹדֶשׁ׃
            <lb n="30"/>וְשַׁבָּת קְרֹא מִקְרָא לֹא א
            <lb n="31"/>אוּכַל עָוֶן וַעֲצָרָה חֹדֶשׁ׃
            <lb n="32"/>וּמוֹעֲדֵיכֶם שָׂנְאָה נַפְשִׁי הֵיוּ
            <lb n="33"/>עָלַי לְטֹרַח נִלְאֵיתִי נְשׂא׃
         </div>
      </body>
   </text>
